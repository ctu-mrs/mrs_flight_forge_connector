# usage: cmake -DA=<dir> -DB=<dir> -P compare_dirs.cmake; fails unless both trees hold the same files with the same bytes
file(GLOB_RECURSE FilesA RELATIVE ${A} ${A}/*)
file(GLOB_RECURSE FilesB RELATIVE ${B} ${B}/*)
list(SORT FilesA)
list(SORT FilesB)
if (NOT FilesA STREQUAL FilesB)
    message(FATAL_ERROR "file lists differ:\n  ${A}: ${FilesA}\n  ${B}: ${FilesB}")
endif ()
foreach (File ${FilesA})
    execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${A}/${File} ${B}/${File} RESULT_VARIABLE Differ)
    if (Differ)
        message(FATAL_ERROR "${File} differs between ${A} and ${B}")
    endif ()
endforeach ()
